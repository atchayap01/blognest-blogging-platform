# MongoDB Atlas connection string (e.g., mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/blognest?retryWrites=true&w=majority)
MONGODB_URI=

# JWT Secret for signing authentication tokens
JWT_SECRET=your_super_secret_jwt_key_here

# Server Port (3000 in AI Studio dev environment, 5000 in standalone backend)
PORT=3000

# Client origin for CORS
CLIENT_URL=http://localhost:3000

